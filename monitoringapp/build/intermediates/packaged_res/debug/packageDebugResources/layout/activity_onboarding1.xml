<LinearLayout 
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:background="#FFFFFF"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<ScrollView 
		android:id="@+id/rjlp5enrcyx"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:fillViewport="true"
		android:background="#161618">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/ru08z33v6gd"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:paddingTop="298dp"
				android:orientation="vertical">
				<ImageView
					android:id="@+id/rfsrbtilwtmk"
					android:layout_width="172dp"
					android:layout_height="172dp"
					android:layout_marginBottom="104dp"
					android:src="@android:drawable/star_big_on"
					android:scaleType="fitXY"
				/>
				<TextView
					android:id="@+id/rlnlvkcd7yq"
					android:textColor="#FFFFFF"
					android:textSize="35sp"
					android:textStyle="bold"
					android:layout_marginBottom="19dp"
					android:layout_height="wrap_content"
					android:layout_width="wrap_content"
					android:text="Check Connection"
				/>
				<TextView
					android:id="@+id/rju20re5jkh"
					android:textColor="#FFFFFF"
					android:textSize="18sp"
					android:layout_marginBottom="28dp"
					android:layout_marginHorizontal="48dp"
					android:layout_height="wrap_content"
					android:layout_width="match_parent"
					android:layout_weight="1"
					android:gravity="center"
					android:text="Connect Salin-Suri in the embedded water-quality monitoring system and access sensor readings from your device."
				/>
				<LinearLayout
					android:id="@+id/rlzd7pr9g3b"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:layout_marginBottom="83dp"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/ri2ay2lyb6s"
						android:layout_width="39dp"
						android:layout_height="12dp"
						android:background="@drawable/cr20b76ce98"
						android:layout_marginEnd="10dp"
						android:orientation="vertical">
					</LinearLayout>
					<LinearLayout
						android:id="@+id/ra6f2o4ygamp"
						android:layout_width="12dp"
						android:layout_height="12dp"
						android:background="@drawable/cr20b2d3535"
						android:layout_marginEnd="10dp"
						android:orientation="vertical">
					</LinearLayout>
					<LinearLayout
						android:id="@+id/rrhhbd0bqy6a"
						android:layout_width="12dp"
						android:layout_height="12dp"
						android:background="@drawable/cr20b2d3535"
						android:orientation="vertical">
					</LinearLayout>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/rof1jd72f9pi"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:background="@drawable/cr20b76ce98"
					android:paddingVertical="12dp"
					android:layout_marginBottom="19dp"
					android:layout_marginHorizontal="22dp"
					android:clickable="true"
					android:focusable="true"
					android:orientation="vertical">
					<TextView
						android:id="@+id/rs42s5osibzj"
						android:textColor="#FFFFFF"
						android:textSize="18sp"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text="Next"
					/>
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>

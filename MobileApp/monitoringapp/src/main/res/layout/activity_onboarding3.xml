<LinearLayout 
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:background="#FFFFFF"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<ScrollView 
		android:id="@+id/rjk6s5io0bg"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:fillViewport="true"
		android:background="#161618"
		android:paddingTop="320dp">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/refgghejy9a"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:layout_marginBottom="104dp"
				android:layout_marginStart="57dp"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/recczlogpxr"
					android:layout_width="149dp"
					android:layout_height="149dp"
					android:layout_marginEnd="1dp"
					android:src="@android:drawable/star_big_on"
					android:scaleType="fitXY"
				/>
				<ImageView
					android:id="@+id/re6w0yhqfcyo"
					android:layout_width="173dp"
					android:layout_height="145dp"
					android:src="@android:drawable/star_big_on"
					android:scaleType="fitXY"
				/>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/rio4obr3fn"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:layout_marginBottom="22dp"
				android:orientation="vertical">
				<TextView
					android:id="@+id/rlip26sdctve"
					android:textColor="#FFFFFF"
					android:textSize="35sp"
					android:textStyle="bold"
					android:layout_height="wrap_content"
					android:layout_width="wrap_content"
					android:text="Track Changes"
				/>
			</LinearLayout>
			<TextView
				android:id="@+id/r4034bqyljky"
				android:textColor="#FFFFFF"
				android:textSize="18sp"
				android:layout_marginBottom="46dp"
				android:layout_marginHorizontal="34dp"
				android:layout_height="wrap_content"
				android:layout_width="match_parent"
				android:layout_weight="1"
				android:gravity="center"
				android:text="Explore historical readings and compare measurements with configured reference ranges."
			/>
			<LinearLayout
				android:id="@+id/reb7suxlf9u"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:layout_marginBottom="83dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/rs4qtciu52r"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/rtevjv14gn8e"
						android:layout_width="12dp"
						android:layout_height="12dp"
						android:background="@drawable/cr20b2d3535"
						android:layout_marginEnd="10dp"
						android:orientation="vertical">
					</LinearLayout>
					<LinearLayout
						android:id="@+id/regzj1henffa"
						android:layout_width="12dp"
						android:layout_height="12dp"
						android:background="@drawable/cr20b2d3535"
						android:layout_marginEnd="10dp"
						android:orientation="vertical">
					</LinearLayout>
					<LinearLayout
						android:id="@+id/r188heri96a7"
						android:layout_width="39dp"
						android:layout_height="12dp"
						android:background="@drawable/cr20b76ce98"
						android:orientation="vertical">
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/rhr7zj6ajmi"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:background="@drawable/cr20b76ce98"
				android:paddingVertical="12dp"
				android:layout_marginBottom="19dp"
				android:layout_marginHorizontal="22dp"
				android:clickable="true"
				android:focusable="true"
				android:orientation="vertical">
				<TextView
					android:id="@+id/r9r1fgn2c3fd"
					android:textColor="#FFFFFF"
					android:textSize="18sp"
					android:layout_height="wrap_content"
					android:layout_width="wrap_content"
					android:text="Get Started"
				/>
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
